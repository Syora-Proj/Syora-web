# Shopify Storefront Configuration
# Canonical variable name: VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN (matches Shopify's own
# "Storefront API access token" naming, and what's configured in Vercel). Do not use
# VITE_SHOPIFY_STOREFRONT_TOKEN -- that name was a mismatch that caused a real prerender
# HTTP 400 in production. See FRONTEND_CHANGELOG.md / git history for the incident.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-access-token
VITE_SHOPIFY_API_VERSION=2026-10

# Vercel / server aliases (same values, no VITE_ prefix -- for any server-side usage)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-access-token
SHOPIFY_API_VERSION=2026-10

# Shopify Admin API -- PRIVATE server token, never prefix with VITE_, never use in frontend code
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Customer Account API (OAuth client ID) -- not wired into any code yet
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cashfree Payment Gateway -- PRIVATE server credentials, never prefix with VITE_, never use in frontend code
# Powers /api/cashfree-create-order.js and /api/cashfree-webhook.js
CASHFREE_CLIENT_ID=CFxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_CLIENT_SECRET=cfsk_xx_xxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx
CASHFREE_ENV=production
CASHFREE_API_VERSION=2026-01-01

# Public site URL -- used to build Cashfree return_url / notify_url (webhook)
SITE_URL=https://syora.co.in

# Client-safe (not a secret) -- tells the frontend Cashfree SDK which mode to
# render its checkout UI in. Must match CASHFREE_ENV above.
VITE_CASHFREE_MODE=production
